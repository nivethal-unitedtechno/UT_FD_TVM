<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Amount</field>
        <field>Total_Discount__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>VP_of_Client_Services__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>dturner@teamvelocitymarketing.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>efrate@teamvelocitymarketing.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>jennifer@teamvelocitymarketing.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Upsell Approval</label>
        <name>Upsell_Approval</name>
    </approvalStep>
    <emailTemplate>System/Opportunity_Requiring_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND (7 OR 8 OR 9) AND 10</booleanFilter>
        <criteriaItems>
            <field>Opportunity.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Not Yet Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Support__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.VP_of_Client_Services__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Analytics_Franchise__c</field>
            <operation>notEqual</operation>
            <value>FORD</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Analytics_Franchise__c</field>
            <operation>notEqual</operation>
            <value>LINCOLN</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Client_Type_Team_V__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Owner_Profile__c</field>
            <operation>equals</operation>
            <value>RAD</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Owner_Profile__c</field>
            <operation>equals</operation>
            <value>VP of Client Services</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Owner_Profile__c</field>
            <operation>equals</operation>
            <value>VP of Customer Success</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.RecordType</field>
            <operation>notEqual</operation>
            <value>Direct Enrollment</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Opportunity_Approved</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_Status_Pending_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Upsell Approval RAD</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Not_Yet_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
