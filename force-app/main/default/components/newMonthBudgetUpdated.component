<apex:component access="global" controller="budgetsOfAccount">

    <apex:attribute name="accountIdValue" type="String" description="This is the Id of the account" assignTo="{!accountId}" access="global" />
    <html>
    <head>
    <style type="text/css" media="print">
          table th{
            font-size: 11px;
            font-face: arial;
            background: #CCCCCC;
            border-width: 1;
            text-align: center 
            } 
          table td{
            font-size: 11px;
            font-face: verdana 
            } 
          table {
            border: solid #CCCCCC;
            border-width: 1
            }
          table tr{
            border: solid #CCCCCC;
            border-width: 1
            }
    </style> 
    </head>
    </html>        
        {!account.Name} Budget<br/>
        <apex:repeat value="{!newOpps}" var="MediaObj">
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.PPC_Budget_Sales__c), MediaObj.PPC_Budget_Sales__c = 0))}">
                <span>New Search: ${!MediaObj.PPC_Budget_Sales__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.PPC_Budget_Service__c), MediaObj.PPC_Budget_Service__c = 0))}">
                <span>Service Search: ${!MediaObj.PPC_Budget_Service__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.PPC_Budget_DISC__c), MediaObj.PPC_Budget_DISC__c = 0))}">
                <span>Used Search: ${!MediaObj.PPC_Budget_DISC__c} </span><br/>
            </apex:outputPanel>   
            
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Video_Budget_Sales__c), MediaObj.Video_Budget_Sales__c = 0))}">
                <span>New Video: ${!MediaObj.Video_Budget_Sales__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Video_Budget_Preowned__c), MediaObj.Video_Budget_Preowned__c = 0))}">
                <span>Used Video: ${!MediaObj.Video_Budget_Preowned__c} </span><br/>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Display_Budget_Sales__c), MediaObj.Display_Budget_Sales__c = 0))}">
                <span>New Display: ${!MediaObj.Display_Budget_Sales__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Display_Budget_Preowned__c), MediaObj.Display_Budget_Preowned__c = 0))}">
                <span>Used Display: ${!MediaObj.Display_Budget_Preowned__c} </span><br/>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.SMA_Budget_Sales__c), MediaObj.SMA_Budget_Sales__c = 0))}">
                <span>New Facebook: ${!MediaObj.SMA_Budget_Sales__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.SMA_Budget_Service__c), MediaObj.SMA_Budget_Service__c = 0))}">
                <span>Service Facebook: ${!MediaObj.SMA_Budget_Service__c} </span><br/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.SMA_Budget_Preowned__c), MediaObj.SMA_Budget_Preowned__c = 0))}">
                <span>Used Facebook: ${!MediaObj.SMA_Budget_Preowned__c} </span><br/>
            </apex:outputPanel>     
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.PPC_Budget_VLA_New__c), MediaObj.PPC_Budget_VLA_New__c = 0))}">
                <span>New Vehicle Ads: ${!MediaObj.PPC_Budget_VLA_New__c} </span><br/>
            </apex:outputPanel>   
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.PPC_Budget_VLA_Used__c), MediaObj.PPC_Budget_VLA_Used__c = 0))}">
                <span>Used Vehicle Ads: ${!MediaObj.PPC_Budget_VLA_Used__c} </span><br/>
            </apex:outputPanel>  
             
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Performance_Max_New_Budget__c), MediaObj.Performance_Max_New_Budget__c = 0))}">
                <span>New Performance Max: ${!MediaObj.Performance_Max_New_Budget__c} </span><br/>
            </apex:outputPanel>   
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Performance_Max_Used_Budget__c), MediaObj.Performance_Max_Used_Budget__c = 0))}">
                <span>Used Performance Max: ${!MediaObj.Performance_Max_Used_Budget__c} </span><br/>
            </apex:outputPanel>  
            
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.OTT_Premium_Custom_Budget__c), MediaObj.OTT_Premium_Custom_Budget__c = 0))}">
                <span>OTT Budget: ${!MediaObj.OTT_Premium_Custom_Budget__c} </span><br/>
            </apex:outputPanel>   
            <apex:outputPanel rendered="{!NOT(OR(ISBLANK(MediaObj.Custom_Dynamic_Pre_Roll_Production_Budge__c), MediaObj.Custom_Dynamic_Pre_Roll_Production_Budge__c = 0))}">
                <span>Semi-Custom OTT Creative Fee: ${!MediaObj.Custom_Dynamic_Pre_Roll_Production_Budge__c} </span><br/>
            </apex:outputPanel>   
        </apex:repeat>        
</apex:component>